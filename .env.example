# このファイルをコピーして .env を作り、実際の値を入れてください（.env はコミットされません）。
#   cp .env.example .env
#
# EXPO_PUBLIC_ から始まる変数はアプリのビルドに埋め込まれます（=誰でも見える）。
# ここに Stripe の「秘密鍵」や Supabase の service_role キーは絶対に書かないでください。
# それらは Supabase の Edge Function シークレットにのみ設定します（下の「サーバー側」参照）。

# --- クライアント側（アプリに埋め込む・公開してよい値） ---

# Supabase プロジェクトの Settings > API から取得
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe の「公開可能キー」(pk_test_... / pk_live_...)。Stripeダッシュボード > 開発者 > APIキー
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx


# --- サーバー側（Supabase Edge Function のシークレット。ここには書かず、下のコマンドで設定する） ---
#
# supabase secrets set STRIPE_SECRET_KEY=<Stripeダッシュボードのシークレットキー sk_test_… >
# supabase secrets set STRIPE_WEBHOOK_SECRET=<StripeのWebhook署名シークレット whsec_… >
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY は Edge Function 実行時に自動で渡されるため
# 手動で設定する必要はありません。
