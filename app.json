{
  "expo": {
    "name": "覚悟の勉強",
    "slug": "tsuzukeru-app",
    "version": "1.2.0",
    "owner": "naotaka0131",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tsuzukeru",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e585da06-9e9e-4f8b-b987-c0a07a8d5603"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naotaka0131.kakugo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D12"
      },
      "package": "com.naotaka0131.kakugo"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール写真を選ぶために写真ライブラリへのアクセスを許可してください。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e585da06-9e9e-4f8b-b987-c0a07a8d5603"
      }
    }
  }
}
